{
  "name": "@kardesler/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"app/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\"",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "gen:api": "pnpm -C ../backend exec tsx src/scripts/generate-api-docs.ts --json ../mobile/src/api/generated/openapi.json && openapi-typescript src/api/generated/openapi.json -o src/api/generated/schema.d.ts",
    "check:contract": "node scripts/check-contract.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@kardesler/shared": "workspace:*",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-native-community/netinfo": "11.4.1",
    "@sentry/react-native": "~6.3.0",
    "@tanstack/react-query": "^5.62.0",
    "expo": "~52.0.37",
    "expo-application": "~6.0.2",
    "expo-constants": "~17.0.7",
    "expo-crypto": "~14.0.2",
    "expo-device": "~7.0.2",
    "expo-linking": "~7.0.5",
    "expo-location": "~18.0.7",
    "expo-notifications": "~0.29.13",
    "expo-router": "~4.0.17",
    "expo-secure-store": "~14.0.1",
    "expo-status-bar": "~2.0.1",
    "expo-web-browser": "~14.0.2",
    "lucide-react-native": "^0.468.0",
    "openapi-fetch": "^0.13.4",
    "query-string": "^7.1.3",
    "react": "18.3.1",
    "react-hook-form": "^7.54.2",
    "react-native": "0.76.7",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-maps": "1.18.0",
    "react-native-reanimated": "~3.16.1",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^12.9.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~18.3.12",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-boundaries": "^5.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~52.0.6",
    "msw": "^2.7.0",
    "openapi-typescript": "^7.5.2",
    "prettier": "^3.4.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.18.0"
  }
}