{
  "cli": {
    "version": ">= 13.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_ENV": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_ENV": "preview",
        "EXPO_PUBLIC_API_URL": "https://kardeslerapp.onrender.com",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "717773080616-8n5u4e1at0aecotdvkknfiree5lcm5ct.apps.googleusercontent.com",
        "EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID": "717773080616-v8cu51sbfc5e1qdsh6ooe8nfnj9s0arg.apps.googleusercontent.com",
        "EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID": "717773080616-cukeglj0gd30f412qtefglr225rhgibi.apps.googleusercontent.com",
        "EXPO_PUBLIC_GOOGLE_REDIRECT_URI": "kardesler://auth/google"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_ENV": "production",
        "EXPO_PUBLIC_API_URL": "https://kardeslerapp.onrender.com",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "717773080616-8n5u4e1at0aecotdvkknfiree5lcm5ct.apps.googleusercontent.com",
        "EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID": "717773080616-v8cu51sbfc5e1qdsh6ooe8nfnj9s0arg.apps.googleusercontent.com",
        "EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID": "717773080616-cukeglj0gd30f412qtefglr225rhgibi.apps.googleusercontent.com",
        "EXPO_PUBLIC_GOOGLE_REDIRECT_URI": "kardesler://auth/google"
      }
    }
  },
  "submit": {
    "production": {}
  }
}

