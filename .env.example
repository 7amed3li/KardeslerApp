# =============================================================================
# Kardeşler Cihangir Backend — Environment Variables Example
# Copy to .env for local development. In production, inject real 32+ char
# secrets from a secrets manager (never commit .env or use dev_*/change_me!).
# =============================================================================

NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Least-privilege runtime PostgreSQL roles (NEVER use postgres or app_migrator here)
DATABASE_URL=postgresql://app_api:api_dev_secret_change_me@127.0.0.1:5434/kardesler_db
DATABASE_READONLY_URL=postgresql://app_readonly:readonly_dev_secret_change_me@127.0.0.1:5434/kardesler_db

# Redis 7 (rate limiting, cache, SSE event bus, print-agent JTI revocation, BullMQ)
REDIS_URL=redis://127.0.0.1:6379

# JWT HS256 signing & kid key rotation (each secret >= 32 characters)
JWT_KEY_ID=k1
# JWT_PREVIOUS_KEY_ID=k0
JWT_CUSTOMER_SECRET=dev_customer_secret_key_change_me_in_production_12345
# JWT_CUSTOMER_PREVIOUS_SECRET=
JWT_STAFF_SECRET=dev_staff_secret_key_change_me_in_production_67890
# JWT_STAFF_PREVIOUS_SECRET=
JWT_PRINT_SECRET=dev_print_agent_secret_key_change_me_production_abcde
# JWT_PRINT_PREVIOUS_SECRET=

# Cryptography & webhook HMAC verification
OTP_HMAC_SECRET=dev_otp_hmac_sha256_secret_key_change_me_in_prod_999
TOTP_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
WEBHOOK_HMAC_SECRET=dev_payment_webhook_hmac_secret_change_me_in_prod_777

# CORS & Store Review Demo OTP (must stay false in production)
ADMIN_ORIGIN=http://localhost:5173
ALLOW_REVIEW_DEMO_OTP=false
REVIEW_DEMO_PHONE=+905000000000
REVIEW_DEMO_OTP_CODE=145300

