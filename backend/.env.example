# Backend Environment Example (Safe Placeholders Only — Never Commit Real Secrets)
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

DATABASE_URL=postgresql://app_api:CHANGE_ME@127.0.0.1:5434/kardesler_db
DATABASE_READONLY_URL=postgresql://app_readonly:CHANGE_ME@127.0.0.1:5434/kardesler_db
REDIS_URL=redis://127.0.0.1:6379

JWT_KEY_ID=k1
JWT_CUSTOMER_SECRET=CHANGE_ME_AT_LEAST_32_CHARS_RANDOM_SECRET
JWT_STAFF_SECRET=CHANGE_ME_AT_LEAST_32_CHARS_RANDOM_SECRET
JWT_PRINT_SECRET=CHANGE_ME_AT_LEAST_32_CHARS_RANDOM_SECRET
OTP_HMAC_SECRET=CHANGE_ME_AT_LEAST_32_CHARS_RANDOM_SECRET
TOTP_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
WEBHOOK_HMAC_SECRET=CHANGE_ME_AT_LEAST_32_CHARS_RANDOM_SECRET

# Google OAuth / OIDC (Server-side allowlists & confidential web secret)
GOOGLE_CLIENT_IDS=NEEDS_CONFIRMATION_IOS_CLIENT_ID,NEEDS_CONFIRMATION_ANDROID_CLIENT_ID,NEEDS_CONFIRMATION_WEB_CLIENT_ID
GOOGLE_REDIRECT_URIS=kardesler://auth/google,http://localhost:8081/auth
GOOGLE_WEB_CLIENT_SECRET=

# Optional SMS OTP (legacy / explicit verification only)
ALLOW_REVIEW_DEMO_OTP=false
ADMIN_ORIGIN=http://localhost:5173

