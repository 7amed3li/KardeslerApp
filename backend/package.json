{
  "name": "@kardesler/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/main.js",
    "start:dev": "tsx watch src/main.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm arch && pnpm test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "arch": "depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "mutate": "stryker run",
    "docs:generate": "tsx src/scripts/generate-api-docs.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.1",
    "@fastify/swagger": "^9.9.3",
    "@kardesler/shared": "workspace:*",
    "argon2": "^0.41.1",
    "bullmq": "^6.7.4",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.2.1",
    "fastify-type-provider-zod": "^4.0.2",
    "ioredis": "^5.6.0",
    "jose": "^6.2.17",
    "otplib": "^12.0.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "postgres": "^3.4.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@stryker-mutator/core": "^8.7.1",
    "@stryker-mutator/vitest-runner": "^8.7.1",
    "@types/node": "^22.13.5",
    "@vitest/coverage-v8": "^3.2.7",
    "dependency-cruiser": "^16.10.4",
    "eslint-plugin-boundaries": "^7.4.2",
    "fast-check": "^4.10.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^3.0.6"
  }
}
