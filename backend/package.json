{
  "name": "@kardesler/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "tsx watch src/main.ts",
    "check": "pnpm typecheck && pnpm test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "vitest run"
  },
  "dependencies": {
    "@kardesler/shared": "workspace:*",
    "@fastify/helmet": "^13.0.1",
    "@fastify/cors": "^11.0.0",
    "@fastify/cookie": "^11.0.2",
    "fastify": "^5.2.1",
    "drizzle-orm": "^0.40.0",
    "postgres": "^3.4.5",
    "ioredis": "^5.6.0",
    "zod": "^3.24.2",
    "argon2": "^0.41.1",
    "otplib": "^12.0.1",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.5",
    "typescript": "^5.7.3",
    "tsx": "^4.19.3",
    "vitest": "^3.0.6"
  }
}
